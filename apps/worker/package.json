{
  "name": "@context-whisperer/worker",
  "version": "0.0.1",
  "scripts": {
    "build": "tsc --noEmit",
    "start": "tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest test/unit",
    "test:unit": "jest test/unit",
    "test:integration": "jest test/integration",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@context-whisperer/core": "workspace:*",
    "@context-whisperer/database": "workspace:*",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.7",
    "@langchain/langgraph-checkpoint-mongodb": "^1.0.0",
    "@langchain/openai": "^1.4.7",
    "bullmq": "^5.8.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.4.1",
    "mongodb": "^6.12.0",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.4.2",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@langchain/langgraph$": "<rootDir>/test/__mocks__/langgraph.mock.ts"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
